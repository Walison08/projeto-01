<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Teste seus conhecimentos sobre mitos e verdades do mundo animal." />
    <title>Confere Aí | Mitos e Verdades</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap');

        :root {
            --ink: #173042;
            --muted: #5e7180;
            --paper: #f7f3ec;
            --white: #fffdf9;
            --teal: #087f8c;
            --teal-dark: #075b67;
            --coral: #f26b5b;
            --line: #d8e1de;
            --shadow: 0 24px 60px rgba(23, 48, 66, 0.13);
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-width: 320px;
            margin: 0;
            color: var(--ink);
            background: var(--paper);
            font-family: 'DM Sans', sans-serif;
        }

        body::before {
            position: fixed;
            z-index: -1;
            inset: 0;
            content: '';
            opacity: 0.45;
            background-image: linear-gradient(rgba(8, 127, 140, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(8, 127, 140, 0.05) 1px, transparent 1px);
            background-size: 34px 34px;
        }

        .cabecalho,
        .conteudo,
        .rodape {
            width: min(100% - 40px, 1080px);
            margin-inline: auto;
        }

        .cabecalho {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 28px 0;
        }

        .marca {
            display: flex;
            align-items: center;
            gap: 11px;
            color: var(--ink);
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.25rem;
            font-weight: 700;
            text-decoration: none;
        }

        .marca-simbolo {
            display: grid;
            width: 38px;
            height: 38px;
            place-items: center;
            color: var(--white);
            background: var(--coral);
            border-radius: 12px 12px 12px 4px;
            font-size: 1.25rem;
            transform: rotate(-6deg);
        }

        .navegacao a {
            color: var(--teal-dark);
            font-weight: 700;
            text-decoration: none;
        }

        .navegacao a:hover,
        .navegacao a:focus-visible {
            color: var(--coral);
        }

        .hero {
            display: grid;
            grid-template-columns: 1fr auto;
            align-items: end;
            gap: 32px;
            padding: 64px 0 40px;
        }

        .etiqueta {
            margin: 0 0 14px;
            color: var(--coral);
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        h1,
        h2,
        p {
            margin-top: 0;
        }

        h1,
        h2 {
            font-family: 'Space Grotesk', sans-serif;
        }

        h1 {
            max-width: 650px;
            margin-bottom: 18px;
            font-size: clamp(2.7rem, 7vw, 5.8rem);
            line-height: 0.98;
            letter-spacing: -0.04em;
        }

        .introducao {
            max-width: 580px;
            margin-bottom: 0;
            color: var(--muted);
            font-size: 1.1rem;
            line-height: 1.65;
        }

        .contador {
            min-width: 130px;
            padding: 18px 20px;
            color: var(--white);
            background: var(--teal);
            border-radius: 18px 18px 4px 18px;
            box-shadow: 8px 8px 0 rgba(242, 107, 91, 0.75);
            text-align: center;
        }

        .contador strong {
            display: block;
            font-family: 'Space Grotesk', sans-serif;
            font-size: 2rem;
        }

        .contador span {
            font-size: 0.8rem;
            opacity: 0.9;
        }

        .area-cartao {
            display: grid;
            grid-template-columns: minmax(0, 560px) 190px;
            justify-content: center;
            align-items: center;
            gap: 52px;
            padding: 28px 0 72px;
        }

        .cartao {
            min-height: 520px;
            perspective: 1200px;
            cursor: pointer;
        }

        .cartao-conteudo {
            position: relative;
            width: 100%;
            height: 100%;
            min-height: 520px;
            transition: transform 650ms cubic-bezier(0.2, 0.8, 0.2, 1);
            transform-style: preserve-3d;
        }

        .cartao.virado .cartao-conteudo {
            transform: rotateY(180deg);
        }

        .cartao-face {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border: 1px solid rgba(8, 127, 140, 0.12);
            border-radius: 26px;
            background: var(--white);
            box-shadow: var(--shadow);
            backface-visibility: hidden;
        }

        .cartao-verso {
            transform: rotateY(180deg);
            background: var(--teal-dark);
            color: var(--white);
        }

        .cartao-imagem {
            width: 100%;
            height: 300px;
            object-fit: cover;
        }

        .cartao-texto {
            display: flex;
            flex: 1;
            flex-direction: column;
            justify-content: center;
            padding: 28px 34px 32px;
        }

        .cartao-indice {
            margin-bottom: 12px;
            color: var(--coral);
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .cartao-verso .cartao-indice {
            color: #86e0d6;
        }

        .cartao-frase {
            margin-bottom: 0;
            font-family: 'Space Grotesk', sans-serif;
            font-size: clamp(1.55rem, 3vw, 2.25rem);
            line-height: 1.12;
        }

        .cartao-dica {
            margin: 16px 0 0;
            color: var(--muted);
            line-height: 1.55;
        }

        .cartao-verso .cartao-dica {
            color: rgba(255, 253, 249, 0.78);
        }

        .controles {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        button {
            border: 0;
            font: inherit;
            cursor: pointer;
        }

        .botao {
            min-height: 48px;
            padding: 12px 18px;
            border-radius: 12px;
            font-weight: 700;
            transition: transform 180ms ease, background-color 180ms ease;
        }

        .botao:hover,
        .botao:focus-visible {
            transform: translateY(-2px);
        }

        .botao:focus-visible,
        .cartao:focus-visible {
            outline: 3px solid var(--coral);
            outline-offset: 4px;
        }

        .botao-principal {
            color: var(--white);
            background: var(--coral);
        }

        .botao-principal:hover,
        .botao-principal:focus-visible {
            background: #dc5749;
        }

        .botao-secundario {
            color: var(--teal-dark);
            background: rgba(8, 127, 140, 0.1);
        }

        .botao-secundario:hover,
        .botao-secundario:focus-visible {
            background: rgba(8, 127, 140, 0.18);
        }

        .atalho {
            margin: 4px 0 0;
            color: var(--muted);
            font-size: 0.8rem;
            line-height: 1.5;
        }

        .rodape {
            padding: 22px 0 34px;
            border-top: 1px solid var(--line);
            color: var(--muted);
            font-size: 0.9rem;
            text-align: center;
        }

        .rodape p {
            margin: 0;
        }

        @media (max-width: 760px) {
            .cabecalho,
            .conteudo,
            .rodape {
                width: min(100% - 28px, 600px);
            }

            .hero {
                grid-template-columns: 1fr;
                gap: 24px;
                padding-top: 40px;
            }

            .contador {
                justify-self: start;
            }

            .area-cartao {
                grid-template-columns: 1fr;
                gap: 28px;
                padding-top: 12px;
            }

            .controles {
                display: grid;
                grid-template-columns: 1fr 1fr;
            }

            .atalho {
                grid-column: 1 / -1;
            }
        }

        @media (max-width: 480px) {
            h1 {
                font-size: 3.2rem;
            }

            .cartao,
            .cartao-conteudo {
                min-height: 490px;
            }

            .cartao-imagem {
                height: 260px;
            }

            .cartao-texto {
                padding: 24px;
            }

            .controles {
                grid-template-columns: 1fr;
            }

            .atalho {
                grid-column: auto;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>
    <header class="cabecalho">
        <a class="marca" href="#inicio" aria-label="Confere Aí - início">
            <span class="marca-simbolo" aria-hidden="true">?</span>
            <span>Confere Aí</span>
        </a>
        <nav class="navegacao" aria-label="Navegação principal">
            <a href="#cartao">Jogar agora</a>
        </nav>
    </header>

    <main id="inicio" class="conteudo">
        <section class="hero" aria-labelledby="titulo">
            <div>
                <p class="etiqueta">Mitos e verdades · Mundo animal</p>
                <h1 id="titulo">Você confere ou cai no mito?</h1>
                <p class="introducao">Teste seus conhecimentos sobre os animais. Pense na resposta e vire o cartão para descobrir a verdade.</p>
            </div>
            <div class="contador" aria-live="polite">
                <strong id="numero-cartao">01</strong>
                <span>de 01 cartão</span>
            </div>
        </section>

        <section id="cartao" class="area-cartao" aria-label="Flashcard sobre pinguins">
            <div
                class="cartao"
                id="flashcard"
                role="button"
                tabindex="0"
                aria-label="Cartão: pinguins conseguem voar como pássaros. Clique para revelar a resposta."
                aria-pressed="false"
            >
                <div class="cartao-conteudo">
                    <article class="cartao-face cartao-frente">
                        <img
                            class="cartao-imagem"
                            src="https://static.nationalgeographicbrasil.com/files/styles/image_3200/public/mm1012723121410486.jpg?w=850&h=2500"
                            alt="Pinguim em seu ambiente natural"
                        />
                        <div class="cartao-texto">
                            <span class="cartao-indice">Mito ou verdade?</span>
                            <p class="cartao-frase">Pinguins conseguem voar como pássaros.</p>
                            <p class="cartao-dica">Qual é o seu palpite? Clique no cartão para revelar.</p>
                        </div>
                    </article>
                    <article class="cartao-face cartao-verso" aria-hidden="true">
                        <div class="cartao-texto">
                            <span class="cartao-indice">Resposta: mito</span>
                            <p class="cartao-frase">Pinguins não voam, mas são excelentes nadadores.</p>
                            <p class="cartao-dica">As asas deles evoluíram para funcionar como nadadeiras, ajudando-os a se movimentar com agilidade na água.</p>
                        </div>
                    </article>
                </div>
            </div>

            <div class="controles">
                <button class="botao botao-principal" id="botao-revelar" type="button">Revelar resposta</button>
                <button class="botao botao-secundario" id="botao-novo" type="button">Ver novamente</button>
                <p class="atalho">Dica: use <strong>Enter</strong> ou <strong>Espaço</strong> com o cartão selecionado.</p>
            </div>
        </section>
    </main>

    <footer class="rodape">
        <p>Projeto feito por Walison Santos · Aprendendo um cartão por vez.</p>
    </footer>

    <script>
        const flashcard = document.querySelector('#flashcard');
        const botaoRevelar = document.querySelector('#botao-revelar');
        const botaoNovo = document.querySelector('#botao-novo');
        const frente = document.querySelector('.cartao-frente');
        const verso = document.querySelector('.cartao-verso');

        function alternarCartao() {
            const estaVirado = flashcard.classList.toggle('virado');
            flashcard.setAttribute('aria-pressed', String(estaVirado));
            flashcard.setAttribute('aria-label', estaVirado
                ? 'Resposta revelada: pinguins não voam, mas são excelentes nadadores. Clique para voltar.'
                : 'Cartão: pinguins conseguem voar como pássaros. Clique para revelar a resposta.');
            frente.setAttribute('aria-hidden', String(estaVirado));
            verso.setAttribute('aria-hidden', String(!estaVirado));
            botaoRevelar.textContent = estaVirado ? 'Esconder resposta' : 'Revelar resposta';
        }

        function voltarAoInicio() {
            if (flashcard.classList.contains('virado')) {
                alternarCartao();
            }
            flashcard.focus();
        }

        flashcard.addEventListener('click', alternarCartao);
        flashcard.addEventListener('keydown', (evento) => {
            if (evento.key === 'Enter' || evento.key === ' ') {
                evento.preventDefault();
                alternarCartao();
            }
        });
        botaoRevelar.addEventListener('click', alternarCartao);
        botaoNovo.addEventListener('click', voltarAoInicio);
    </script>
</body>
</html>
